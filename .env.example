DATABASE_URL=postgresql+asyncpg://phera:phera@localhost:5432/phera
REDIS_URL=redis://localhost:6379/0
OTEL_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=phera
PHERA_HOST=127.0.0.1
PHERA_PORT=8010
PHERA_ROLE=all
PHERA_DB_SLOW_MS=200
WORKER_QUEUES=workflow,delayed,lifecycle,communication,maintenance
LOG_LEVEL=INFO

# Gallabox WhatsApp — webhook: /api/crm/hooks/gallabox/whatsapp
GALLABOX_API_KEY=
GALLABOX_API_SECRET=
GALLABOX_API_ENDPOINT=https://server.gallabox.com/devapi/messages/whatsapp
GALLABOX_ACCOUNT_ID=
GALLABOX_CHANNEL_ID=
GALLABOX_WEBHOOK_SECRET=
GALLABOX_WHATSAPP_NUMBER=

# Google Group email — webhook: /api/crm/hooks/google_group/email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EMAIL_WEBHOOK_SECRET=
EMAIL_INBOUND_ADDRESS=

# Multi-channel email connectors (IMAP receive + SMTP send, DB-configured via /v1/connectors
# and /v1/email-channels — not env vars). This key encrypts connector secrets at rest.
# Generate once per deployment: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
